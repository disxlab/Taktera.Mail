root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

[*.{json,yml,yaml,axaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
# Preserve Markdown hard line breaks (two trailing spaces).
trim_trailing_whitespace = false
